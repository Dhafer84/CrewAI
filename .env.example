# Copier ce fichier en ".env" et renseigner les vraies valeurs.
# Le fichier ".env" ne doit JAMAIS être commité (voir .gitignore).

# --- Fournisseur LLM principal (choisir un provider) ---
# Groq (free tier, recommandé pour le prototypage)
GROQ_API_KEY=

# Anthropic (optionnel, pour une version finale plus soignée)
ANTHROPIC_API_KEY=

# OpenAI (optionnel)
OPENAI_API_KEY=

# --- Choix du modèle actif ---
# Exemples : groq/llama-3.3-70b-versatile | claude-sonnet-4-6 | gpt-5.4
LLM_MODEL=groq/llama-3.3-70b-versatile

# --- SentinelScan ---
# Jeton GitHub classic SANS AUCUN SCOPE (https://github.com/settings/tokens).
# La recherche publique n'exige aucune permission : si ce jeton fuite,
# l'impact est nul. Ne JAMAIS utiliser ici un jeton ayant accès à des
# dépôts privés.
GITHUB_TOKEN=

# --- Configuration future (Option B) ---
# Laisser vide en Phase 0-5. Utilisé seulement quand l'API sera activée.
API_RATE_LIMIT_PER_MINUTE=
API_DAILY_BUDGET_USD=
